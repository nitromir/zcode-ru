    "ZAI_BUSINESS_BASE_URL",
    "ZAI_PRODUCTION_BUSINESS_BASE_URL",
    "ZAI_TEST_BUSINESS_BASE_URL"
  ],
  "notForExport": [
    "C:/Users/<user>/.zcode/v2/credentials.json",
